{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "meeting-notes",
  "version": "0.0.2",
  "identifier": "com.numericlabs.meeting-notes",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Meeting Notes",
        "width": 400,
        "height": 300,
        "minWidth": 400,
        "minHeight": 300,
        "resizable": true,
        "alwaysOnTop": false,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libayatana-appindicator3-1"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERDMUNFNUU5REMwRkM2QzgKUldUSXhnL2M2ZVVjM0dTV3lraU5hQ2FmTFlqUzhPOVh1RkIrSlhBczFYVVVoc3BKcnVZRUs1SHoK",
      "endpoints": [
        "https://github.com/Snehal1112/meeting-notes/releases/latest/download/latest.json"
      ]
    }
  }
}
